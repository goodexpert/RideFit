    <!-- TTS scripts (speech-optimised — punctuation for natural pauses, no \\n) -->
    <string name="tts_welcome_quiet">안녕하세요. 목적지까지 조용히 모시겠습니다. 편안한 이동 되세요.</string>
    <string name="tts_welcome_fast">안녕하세요! 도착지까지 빠르게 모시겠습니다. 안전벨트 확인해 주세요.</string>
    <string name="tts_welcome_safe">안녕하세요. 안전하게 천천히 모시겠습니다. 편안한 이동 되세요.</string>
    <string name="tts_welcome_media">안녕하세요. 라디오와 음악을 들으며 편안하게 모시겠습니다. 즐거운 이동 되세요.</string>
    <string name="tts_completed">두고 내리실 짐은 없으신가요? 오늘 이동이 만족스러우셨다면, 별점으로 응원해 주시면 감사하겠습니다.</string>
    <string name="tts_transfer">계좌번호를 불러드릴게요. %1$s, %2$s, %3$s 입니다. 이체 완료되시면 말씀해 주세요.</string>
    <string name="tts_transfer_intro">계좌번호를 불러드릴게요. %1$s, %2$s,</string>
    <string name="tts_transfer_outro">입니다. 이체 완료되시면 말씀해 주세요.</string>

